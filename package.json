{
  "name": "ajanraj-tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "bun run photos:validate && vp build",
    "preview": "vp preview",
    "preview:worker": "bun run build && wrangler --cwd .output dev",
    "deploy": "bun run build && wrangler --cwd .output deploy",
    "content:build": "content-collections build",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "typecheck": "bun run content:build && tsc --noEmit",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "bun run photos:validate && bun run content:build && vp check",
    "photos:catalog": "bun scripts/catalog-photography.ts",
    "photos:validate": "bun scripts/validate-photography.ts"
  },
